# ==============================================================================
# Aegis AI — Environment Configuration Template
# ==============================================================================
# 1. Copy this file to .env:
#      copy .env.example .env (Windows)
#      cp .env.example .env   (Linux/macOS)
# 2. Fill in your Groq API key:
#      Get your free API key at https://console.groq.com/keys
# ==============================================================================

# Groq Cloud API Key for LLM query engine
GROQ_API_KEY=your_groq_api_key_here

# Optional: Remote API Backend URL (defaults to http://127.0.0.1:8000 if not specified)
# AEGIS_API_BASE=http://127.0.0.1:8000
